# Required for the managed MySQL database
DATABASE_URL=mysql://user:password@host:3306/database
# Optional; provide the CA bundle when the managed database uses a private certificate.
DATABASE_CA_PATH=

# Required to connect the Discord application
DISCORD_TOKEN=replace-with-discord-bot-token

# Optional: register slash commands in one guild immediately during setup
DISCORD_GUILD_ID=

# Optional; the app listens on PORT or 3000
PORT=3000

# Public base URL of this service (e.g. https://bot.exemplo.com). Discord fetches the embed images from /assets here.
PUBLIC_BASE_URL=
